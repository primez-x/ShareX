<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared layout classes for the settings windows. Windows that need a different value add an override after the include. -->

    <Style Selector="Grid.page-title">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style Selector="TextBlock.page-title-text">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.page-title-icon">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,1,0,3"/>
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.section-card">
        <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="CheckBox.setting">
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="ComboBox.form-control">
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="TextBox.form-control">
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="NumericUpDown.form-control">
        <Setter Property="Width" Value="130"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="ListBox.settings-list">
        <Setter Property="MinHeight" Value="150"/>
        <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</Styles>
