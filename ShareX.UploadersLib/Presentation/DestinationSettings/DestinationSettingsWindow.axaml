<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:ShareX.UploadersLib.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX.UploadersLib"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        x:Class="ShareX.UploadersLib.DestinationSettingsWindow"
        x:DataType="local:DestinationSettingsViewModel"
        Title="{x:Static localization:Strings.DestinationSettingsWindow_ShareX_Destination_settings}"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <StyleInclude Source="avares://ShareX.Avalonia/Theming/SettingsStyles.axaml"/>
        <Style Selector="Grid.preview-row"><Setter Property="Margin" Value="0,6"/></Style>
        <Style Selector="TextBlock.hint.connection-connected">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Status.Success}"/>
        </Style>
        <Style Selector="TextBlock.hint.connection-disconnected">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Status.Error}"/>
        </Style>
        <Style Selector="TreeView.settings-tree">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="TreeView.settings-tree TreeViewItem">
            <Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Styles>

        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}" ColumnDefinitions="220,*">
            <Border Grid.Column="0" Padding="8" Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="0,0,1,0">
                <controls:SettingsNavigation x:Name="Navigation"
                                             Items="{Binding NavigationItems}"
                                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                             SearchRoot="{Binding #SettingsPages}"/>
            </Border>
            <Grid x:Name="SettingsPages" Grid.Column="1"/>
        </Grid>
</Window>
