<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:ShareX"
        xmlns:res="using:ShareX.Localization"
        mc:Ignorable="d"
        d:DesignWidth="680"
        d:DesignHeight="600"
        x:Class="ShareX.HotkeySettingsWindow"
        x:DataType="local:HotkeySettingsViewModel"
        Title="{x:Static res:Strings.HotkeySettingsWindow_WindowTitle}"
        Width="680"
        Height="600"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <ThemeVariantScope>
        <local:HotkeySettingsView/>
    </ThemeVariantScope>
</Window>
