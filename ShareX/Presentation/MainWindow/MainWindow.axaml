<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        xmlns:res="using:ShareX.Localization"
        xmlns:history="using:ShareX.HistoryLib"
        xmlns:local="using:ShareX"
        x:Class="ShareX.MainWindow"
        x:CompileBindings="False"
        Title="ShareX"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="520"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragEnter="OnDragEnter"
        DragDrop.DragLeave="OnDragLeave"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">

    <Window.Styles>
        <!-- Toolbar -->
        <Style Selector="Button.toolbar-action">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="Button.toolbar-action TextBlock.icon">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="Button.capture-primary">
            <Setter Property="CornerRadius" Value="4,0,0,4"/>
        </Style>
        <Style Selector="Button.capture-dropdown">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip TextBlock">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="ToggleButton.filter-chip:checked TextBlock, ToggleButton.filter-chip:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
        </Style>

        <!-- Library grid -->
        <Style Selector="ListBox.capture-rows">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="ListBox.capture-rows ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.capture-rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.capture-rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.capture-rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.capture-rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.capture-card">
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button.capture-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
        </Style>
        <Style Selector="Button.capture-card.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Accent.Start}"/>
        </Style>

        <!-- Preview pane -->
        <Style Selector="TextBlock.detail-label">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="TextBlock.detail-value">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.preview-action">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- Title bar -->
        <Style Selector="Button.caption-button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background.Hover}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.caption-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Control.Background}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBlock.theme-toggle-icon">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Style Selector="^.moon">
                <Setter Property="RenderTransform" Value="translateY(20px) rotate(-45deg)"/>
            </Style>
            <Style Selector="^.sun">
                <Setter Property="RenderTransform" Value="translateY(-20px) rotate(45deg)"/>
            </Style>
            <Style Selector="^.active">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="RenderTransform" Value="translateY(0px) rotate(0deg)"/>
            </Style>
        </Style>
        <Style Selector="Button.caption-close">
            <Setter Property="CornerRadius" Value="0,7,0,0"/>
        </Style>
        <Style Selector="Button.caption-close.maximized">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.caption-close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A51D12"/>
        </Style>
    </Window.Styles>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource ShareX.Brush.Background.Main}"
            BorderBrush="{DynamicResource ShareX.Brush.Border}"
            BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*">
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="38"
                    Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Separator}"
                    BorderThickness="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Margin="14,0,12,0"
                                Orientation="Horizontal"
                                Spacing="9"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Width="20"
                               Height="20"
                               Source="{Binding TitleBarIcon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource ShareX.Brush.Text}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Classes="caption-button"
                                AutomationProperties.Name="{Binding ThemeToggleText}"
                                ToolTip.Tip="{Binding ThemeToggleText}"
                                Click="OnThemeToggleClick"
                                chrome:WindowDecorationProperties.ElementRole="User">
                            <Grid Width="20" Height="20" ClipToBounds="True" IsHitTestVisible="False">
                                <TextBlock Classes="icon theme-toggle-icon moon"
                                           Classes.active="{Binding IsDarkTheme}"
                                           Text="{x:Static theming:LucideIcons.moon}"/>
                                <TextBlock Classes="icon theme-toggle-icon sun"
                                           Classes.active="{Binding !IsDarkTheme}"
                                           Text="{x:Static theming:LucideIcons.sun}"/>
                            </Grid>
                        </Button>
                        <Button Classes="caption-button"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_AlwaysOnTop}"
                                Click="OnTopmostClick"
                                chrome:WindowDecorationProperties.ElementRole="User">
                            <Grid>
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.pin}"
                                           FontSize="13"
                                           IsVisible="{Binding !Topmost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.pin_off}"
                                           FontSize="13"
                                           IsVisible="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </Button>
                        <Button Classes="caption-button"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_Minimize}"
                                Click="OnMinimizeClick"
                                chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.minus}"
                                       FontSize="14"/>
                        </Button>
                        <Button Classes="caption-button"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_MaximizeOrRestore}"
                                Click="OnMaximizeRestoreClick"
                                chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                            <Grid>
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.square}"
                                           FontSize="12"
                                           IsVisible="{Binding !IsWindowMaximized}"/>
                                <TextBlock Classes="icon"
                                           Text="{x:Static theming:LucideIcons.copy}"
                                           FontSize="12"
                                           IsVisible="{Binding IsWindowMaximized}"/>
                            </Grid>
                        </Button>
                        <Button Classes="caption-button caption-close"
                                Classes.maximized="{Binding IsWindowMaximized}"
                                AutomationProperties.Name="{x:Static res:Strings.ActionsToolbarWindow_Close}"
                                Click="OnCloseClick"
                                chrome:WindowDecorationProperties.ElementRole="CloseButton">
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.x}"
                                       FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="12,8"
                    Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                    BorderBrush="{DynamicResource ShareX.Brush.Separator}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="toolbar-action capture-primary active"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_NewCapture}"
                                ToolTip.Tip="{Binding NewCaptureTip}"
                                Click="OnNewCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.scan}"/>
                                <TextBlock Text="{x:Static res:Strings.MainWindow_NewCapture}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewCaptureMenuButton"
                                Classes="toolbar-action capture-dropdown active"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_CaptureOptions}"
                                ToolTip.Tip="{x:Static res:Strings.MainWindow_CaptureOptions}"
                                Click="OnNewCaptureMenuClick">
                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.chevron_down}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Grid Width="260">
                            <TextBox x:Name="SearchTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0,32,0"
                                     PlaceholderText="{x:Static res:Strings.MainWindow_SearchCaptures}"
                                     AutomationProperties.Name="{x:Static res:Strings.MainWindow_SearchCaptures}"
                                     TextChanged="OnSearchTextChanged"/>
                            <TextBlock Classes="icon"
                                       Text="{x:Static theming:LucideIcons.search}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,11,0"
                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton Classes="filter-chip" Tag="{x:Static local:CaptureLibraryFilter.All}" IsChecked="True"
                                          Content="{x:Static res:Strings.MainWindow_FilterAll}"
                                          AutomationProperties.Name="{x:Static res:Strings.MainWindow_FilterAll}"
                                          Click="OnFilterClick"/>
                            <ToggleButton Classes="filter-chip" Tag="{x:Static local:CaptureLibraryFilter.Images}"
                                          Content="{x:Static res:Strings.MainWindow_FilterImages}"
                                          AutomationProperties.Name="{x:Static res:Strings.MainWindow_FilterImages}"
                                          Click="OnFilterClick"/>
                            <ToggleButton Classes="filter-chip" Tag="{x:Static local:CaptureLibraryFilter.Videos}"
                                          Content="{x:Static res:Strings.MainWindow_FilterVideos}"
                                          AutomationProperties.Name="{x:Static res:Strings.MainWindow_FilterVideos}"
                                          Click="OnFilterClick"/>
                            <ToggleButton Classes="filter-chip" Tag="{x:Static local:CaptureLibraryFilter.OtherFiles}"
                                          Content="{x:Static res:Strings.MainWindow_FilterOtherFiles}"
                                          AutomationProperties.Name="{x:Static res:Strings.MainWindow_FilterOtherFiles}"
                                          Click="OnFilterClick"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="MoreButton"
                                Classes="toolbar-action"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_More}"
                                Click="OnMoreClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.menu}"/>
                                <TextBlock Text="{x:Static res:Strings.MainWindow_More}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar-action"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_Settings}"
                                Click="OnSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.settings}"/>
                                <TextBlock Text="{x:Static res:Strings.MainWindow_Settings}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,320">
                <Grid Grid.Column="0">
                    <ListBox x:Name="CaptureRows"
                             Classes="capture-rows"
                             SelectionMode="Single"
                             SizeChanged="OnCaptureRowsSizeChanged"
                             ScrollViewer.BringIntoViewOnFocusChange="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="history:ThumbnailGalleryRow">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:CaptureLibraryItem">
                                            <Button Classes="capture-card"
                                                    Classes.selected="{Binding IsSelected}"
                                                    AutomationProperties.Name="{Binding FileName}"
                                                    ToolTip.Tip="{Binding FilePath}"
                                                    AttachedToVisualTree="OnCardAttached"
                                                    DetachedFromVisualTree="OnCardDetached"
                                                    DataContextChanged="OnCardDataContextChanged"
                                                    Click="OnCardClick">
                                                <StackPanel Width="{Binding ThumbnailWidth}" Spacing="3">
                                                    <Border Width="{Binding ThumbnailWidth}"
                                                            Height="{Binding ThumbnailHeight}"
                                                            Background="{DynamicResource ShareX.Brush.Background.Panel}"
                                                            CornerRadius="4"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform"
                                                                   StretchDirection="DownOnly"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Classes="icon"
                                                                       Text="{Binding PlaceholderIcon}"
                                                                       IsVisible="{Binding ShowPlaceholder}"
                                                                       FontSize="36"
                                                                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                                       Opacity="0.6"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <Border IsVisible="{Binding ShowPlayIcon}"
                                                                    Width="44"
                                                                    Height="44"
                                                                    Background="#B8181818"
                                                                    CornerRadius="22"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    IsHitTestVisible="False">
                                                                <TextBlock Classes="icon"
                                                                           Text="{x:Static theming:LucideIcons.play}"
                                                                           Foreground="#E0E0E0"
                                                                           FontSize="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border IsVisible="{Binding IsFailed}"
                                                                    Background="{DynamicResource ShareX.Brush.Status.Error}"
                                                                    CornerRadius="4"
                                                                    Padding="6,3"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="5">
                                                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.triangle_alert}" Foreground="White"/>
                                                            </Border>
                                                            <ProgressBar IsVisible="{Binding IsProgressVisible}"
                                                                         Value="{Binding Progress}"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Height="5"
                                                                         VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{DynamicResource ShareX.Brush.Text}"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                               FontSize="11"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState"
                                IsVisible="False"
                                MaxWidth="420"
                                Margin="24"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Classes="icon"
                                   Text="{x:Static theming:LucideIcons.images}"
                                   FontSize="44"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateTitle"
                                   FontSize="18"
                                   Foreground="{DynamicResource ShareX.Brush.Text}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateHint"
                                   FontWeight="Normal"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="EmptyStateCaptureButton"
                                Classes="toolbar-action active"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{x:Static res:Strings.MainWindow_CaptureRegion}"
                                Click="OnNewCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.scan}"/>
                                <TextBlock Text="{x:Static res:Strings.MainWindow_CaptureRegion}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                        BorderBrush="{DynamicResource ShareX.Brush.Separator}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <TextBlock x:Name="PreviewHint"
                                   Text="{x:Static res:Strings.MainWindow_SelectCaptureHint}"
                                   Margin="24"
                                   FontWeight="Normal"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="PreviewPanel"
                                      IsVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14" Spacing="12">
                                <Border Height="220"
                                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="PreviewImage"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PreviewPlaceholder"
                                                   Classes="icon"
                                                   FontSize="56"
                                                   Opacity="0.6"
                                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="PreviewName"
                                               FontSize="15"
                                               Foreground="{DynamicResource ShareX.Brush.Text}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PreviewStatus"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <TextBlock Classes="detail-label" Text="{x:Static res:Strings.MainWindow_Date}"/>
                                    <TextBlock x:Name="PreviewDate" Grid.Column="1" Classes="detail-value"/>
                                    <TextBlock x:Name="PreviewDimensionsLabel" Grid.Row="1" Classes="detail-label" Text="{x:Static res:Strings.MainWindow_Dimensions}"/>
                                    <TextBlock x:Name="PreviewDimensions" Grid.Row="1" Grid.Column="1" Classes="detail-value"/>
                                    <TextBlock x:Name="PreviewSizeLabel" Grid.Row="2" Classes="detail-label" Text="{x:Static res:Strings.MainWindow_Size}"/>
                                    <TextBlock x:Name="PreviewSize" Grid.Row="2" Grid.Column="1" Classes="detail-value"/>
                                    <TextBlock Grid.Row="3" Classes="detail-label" Text="{x:Static res:Strings.MainWindow_Folder}"/>
                                    <TextBlock x:Name="PreviewFolder" Grid.Row="3" Grid.Column="1" Classes="detail-value"/>
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="EditButton" Classes="preview-action active"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_Edit}"
                                            Click="OnEditClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.pencil}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_Edit}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_Open}"
                                            Click="OnOpenClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.external_link}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_Open}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CopyButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_Copy}"
                                            Click="OnCopyClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.copy}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_Copy}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CopyFilePathButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_CopyFilePath}"
                                            Click="OnCopyFilePathClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.route}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_CopyFilePath}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ShowInFolderButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_ShowInFolder}"
                                            Click="OnShowInFolderClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.folder_open}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_ShowInFolder}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ShareButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_Share}"
                                            Click="OnShareClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.share_2}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_Share}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteButton" Classes="preview-action"
                                            AutomationProperties.Name="{x:Static res:Strings.MainWindow_Delete}"
                                            Click="OnDeleteClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="icon" Text="{x:Static theming:LucideIcons.trash_2}"/>
                                            <TextBlock Text="{x:Static res:Strings.MainWindow_Delete}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="DropOverlay"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Background="{DynamicResource ShareX.Brush.Overlay.Modal}">
                <Border Width="440"
                        Padding="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ShareX.Brush.Background.Panel}"
                        BorderBrush="{DynamicResource ShareX.Brush.Accent.Start}"
                        BorderThickness="2"
                        CornerRadius="12">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Classes="icon"
                                   Text="{x:Static theming:LucideIcons.upload}"
                                   FontSize="48"
                                   Foreground="{DynamicResource ShareX.Brush.Accent.Start}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropOverlayTitle"
                                   Text="{x:Static res:Strings.MainWindow_ReleaseToUploadFiles}"
                                   FontSize="22"
                                   Foreground="{DynamicResource ShareX.Brush.Text}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropOverlayDescription"
                                   Text="{x:Static res:Strings.MainWindow_FilesDroppedUploadDescription}"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
