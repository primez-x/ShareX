<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:ShareX.ImageEditor.Localization"
             xmlns:vm="using:ShareX.ImageEditor.Presentation.ViewModels"
             xmlns:editorTheming="using:ShareX.ImageEditor.Presentation.Theming"
             xmlns:controls="using:ShareX.ImageEditor.Presentation.Controls"
             x:Class="ShareX.ImageEditor.Presentation.Views.EditorBuiltInToolbars"
             x:DataType="vm:MainViewModel">
    <Grid>
        <Border Classes="editor-toolbar-host top"
                Classes.hidden="{Binding AreToolbarsHidden}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                IsHitTestVisible="{Binding ShowToolbars}">
            <controls:AnnotationToolbar x:Name="AnnotationToolbarControl"
                                        DataContext="{Binding ToolbarAdapter}"
                                        ShowEditingActions="False"
                                        MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Border>

        <Border Classes="editor-toolbar-host bottom"
                Classes.hidden="{Binding AreToolbarsHidden}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Padding="4"
                Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                BorderBrush="{DynamicResource ShareX.Brush.Border}"
                BorderThickness="1"
                CornerRadius="4,4,0,0"
                MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ClipToBounds="False"
                IsHitTestVisible="{Binding ShowToolbars}">
            <StackPanel Orientation="Horizontal" Spacing="4" ClipToBounds="False">
                <controls:ZoomPickerDropdown SelectedZoom="{Binding Zoom}"
                                             ZoomChanged="OnZoomChanged"
                                             ZoomToFitRequested="OnZoomToFitRequested"
                                             Height="40"
                                             ToolTip.Tip="{x:Static res:Strings.EditorView_ZoomCtrlWheel}"
                                             ToolTip.Placement="Top"
                                             ToolTip.VerticalOffset="-5"/>

                <Border Width="1"
                        Height="38"
                        Background="{DynamicResource ShareX.Brush.Separator}"
                        Margin="4,0"
                        IsVisible="{Binding ShowBottomToolbar}"/>

                <Panel Margin="4,0,10,0"
                       VerticalAlignment="Bottom"
                       ClipToBounds="False"
                       IsVisible="{Binding ShowTaskButtons}">
                    <!-- Task mode: labeled buttons, so the user knows that Close keeps the capture. -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding UseContinueWorkflow}">
                        <Button Command="{Binding ContinueCommand}"
                                Classes="task-mode-button success"
                                Height="40"
                                Padding="12,0"
                                CornerRadius="4"
                                BorderThickness="1"
                                ToolTip.Tip="{x:Static res:Strings.MainViewModel_ContinueEnter}"
                                ToolTip.Placement="Top"
                                ToolTip.VerticalOffset="-5"
                                AutomationProperties.Name="{x:Static res:Strings.EditorView_Done}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionContinue}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Foreground}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.EditorView_Done}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ShareX.Brush.TaskMode.Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelCommand}"
                                Height="40"
                                Padding="12,0"
                                ToolTip.Tip="{x:Static res:Strings.EditorView_CloseKeepsCaptureEsc}"
                                ToolTip.Placement="Top"
                                ToolTip.VerticalOffset="-5"
                                AutomationProperties.Name="{x:Static res:Strings.EditorView_Close}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionCancel}"
                                           FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static res:Strings.EditorView_Close}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Width="90"
                          Height="40"
                          ClipToBounds="False"
                          IsVisible="{Binding !UseContinueWorkflow}">
                        <Button Command="{Binding CancelCommand}"
                                Classes="task-mode-button danger"
                                BorderThickness="1"
                                Height="40"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Width="55"
                                Padding="27,0,10,0"
                                CornerRadius="0,4,4,0"
                                ToolTip.Tip="{x:Static res:Strings.EditorView_CancelEsc}"
                                ToolTip.Placement="Top"
                                ToolTip.VerticalOffset="-5"
                                ZIndex="0">
                            <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionCancel}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding ContinueCommand}"
                                Classes="task-mode-button success"
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8"
                                ToolTip.Tip="{x:Static res:Strings.MainViewModel_RunAfterCaptureTasksEnter}"
                                ToolTip.Placement="Top"
                                ToolTip.VerticalOffset="-5"
                                ZIndex="20">
                            <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionContinue}"
                                       FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                                       FontSize="22"
                                       FontWeight="Normal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </Button>
                    </Grid>
                </Panel>

                <Button Command="{Binding CopyCommand}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_CopyimagetoclipboardCtrlC}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionCopy}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>

                <Button Command="{Binding SaveCommand}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_SaveimageCtrlS}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionSave}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>

                <Button Command="{Binding SaveAsCommand}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_SaveimageasEllipsisCtrlShiftS}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionSaveAs}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>

                <Button Command="{Binding PinToScreenCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_PinimagetoscreenCtrlP}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionPinToScreen}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>

                <Button Command="{Binding PrintCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowBottomToolbar}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_PrintimageEllipsisCtrlShiftP}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionPrint}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>

                <Button Command="{Binding UploadCommand}"
                        IsEnabled="{Binding HasPreviewImage}"
                        Width="40"
                        Padding="0"
                        IsVisible="{Binding ShowUploadButton}"
                        ToolTip.Tip="{x:Static res:Strings.EditorView_UploadimageCtrlU}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-5">
                    <TextBlock Text="{x:Static editorTheming:EditorIcons.ActionUpload}"
                               FontSize="18"
                               FontFamily="{DynamicResource ShareX.FontFamily.Icon}"
                               FontWeight="Normal"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
